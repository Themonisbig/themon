{
  "name": "doll-game-promo",
  "version": "1.0.0",
  "private": true,
  "description": "30s vertical TikTok LIVE promo video built with Remotion",
  "scripts": {
    "audio": "python3 scripts/build_audio.py",
    "studio": "remotion studio",
    "render": "remotion render Promo out/promo.mp4 --codec=h264 --crf=16 --audio-bitrate=320k",
    "build": "npm run audio && npm run render",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/cli": "^4.0.540",
    "@remotion/fonts": "^4.0.540",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.540",
    "@remotion/renderer": "^4.0.540",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
